rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // This directory holds public catalog assets. Never place customer files here.
    match /products/{fileName} {
      allow read: if true;
      allow create: if resource == null && request.auth != null
        && 'admin' in request.auth.token && request.auth.token.admin == true
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      // Immutable names prevent overwriting or deleting an image shared by products.
      allow update, delete: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
